# KOSPI Investor Flow — environment configuration
# Copy to ".env" and adjust. All variables use the KOSPI_ prefix.

# --- Data source -------------------------------------------------------------
# Provider name: sample (offline/default), pykrx (prototype, needs network +
# `pip install pykrx`), or licensed (not yet implemented).
KOSPI_DATA_SOURCE=sample

# --- Database ----------------------------------------------------------------
# SQLAlchemy URL. Default is a local SQLite file. For PostgreSQL/TimescaleDB:
# KOSPI_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/kospi_flow
KOSPI_DATABASE_URL=sqlite:///./data/kospi_flow.db
KOSPI_DB_ECHO=false

# --- Storage layout ----------------------------------------------------------
KOSPI_RAW_DATA_PATH=./data/raw
KOSPI_PROCESSED_DATA_PATH=./data/processed

# --- Time / market -----------------------------------------------------------
KOSPI_TIMEZONE=Asia/Seoul
KOSPI_MARKET=KOSPI
# Benchmark index code (KRX 1001 = KOSPI). Used for outperformance labels and
# market views; the real index replaces the cap-weighted proxy once ingested.
KOSPI_BENCHMARK_INDEX_CODE=1001

# --- Alerting (Phase 5) ------------------------------------------------------
# Channel: none | console | file | webhook
KOSPI_ALERT_CHANNEL=console
KOSPI_ALERT_LOG_FILE=alerts.log
# KOSPI_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX

# --- Model drift (Phase 5) ---------------------------------------------------
KOSPI_DRIFT_PSI_WARN=0.1
KOSPI_DRIFT_PSI_ALERT=0.25

# --- Inference ---------------------------------------------------------------
# Forward horizons the daily scheduler runs inference for. One gbm_return_<h>d
# model bundle must exist per horizon (see models/).
KOSPI_PREDICT_HORIZONS=1,3,5,10,20

# --- API (Phase 5) -----------------------------------------------------------
# Comma-separated allowed CORS origins; "*" for local dev only.
KOSPI_CORS_ORIGINS=*
